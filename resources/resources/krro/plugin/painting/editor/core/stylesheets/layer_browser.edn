;; component/layer-browser.edn

[{}

 [".layer-browser"
  {:background-color :kr/body-bg
   :padding "8px"
   :border-color :kr/border-color
   :border-width "0 0 0 1px"}]

 [".layer-browser-title"
  {:text-fill :kr/secondary-color
   :font-weight :font-weight-bold
   :font-size :font-size-sm
   :padding "0 0 5px 0"}]

 [".layer-list"
  {:spacing "2px"}]

 [".layer-row"
  {:text-fill :kr/secondary-color
   :padding "4px 6px"
   :background-color "transparent"
   :border-color "transparent"
   :alignment "center-left"
   :spacing "4px"}
  ["&:hover"
   {:background-color :gray-100
    :text-fill :kr/body-color}]]

 [".layer-row-selected"
  {:background-color :gray-100}]

 [".layer-visibility-checkbox"
  {:scale-x "0.8"
   :scale-y "0.8"}]

 [".layer-name"
  {:text-fill :kr/body-color
   :font-size :font-size-xs}
  ["&:hover"
   {:text-fill :kr/secondary-color}]]

 [".layer-name-selected"
  {:text-fill :kr/primary-base
   :font-weight :font-weight-bold}]

 [".layer-lock-icon"
  {:text-fill :kr/secondary-color
   :font-size "10px"}]

 [".layer-button"
  {:font-size "10px"
   :min-width "20px"
   :min-height "20px"
   :padding "2px"
   :background-color "transparent"
   :text-fill :kr/secondary-color}
  ["&:hover"
   {:background-color :gray-100}]]

 [".layer-toolbar"
  {:padding "5px 0 0 0"
   :spacing "4px"}]

 [".layer-toolbar-button"
  {:font-size :font-size-sm
   :min-width "24px"
   :min-height "24px"
   :background-color "transparent"
   :text-fill :kr/secondary-color}
  ["&:hover"
   {:background-color :gray-100}]]]