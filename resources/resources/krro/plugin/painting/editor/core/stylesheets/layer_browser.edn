;; 基本样式文件不导入任何抽象
[
 {}
 [".btn"
  {:font-size "14px"
   :padding "8 16"}]

 [".btn-primary"
  {:background-color "#0078d4"
   :text-fill "white"}]

 [".layer-browser"
  {:background-color :color-panel-bg
   :padding "8px"
   :border-color :color-panel-border
   :border-width "0 0 0 1"}]

 [".layer-browser-title"
  {:text-fill :color-fg
   :font-weight "bold"
   :font-size "13px"
   :padding "0 0 5 0"}]

 [".layer-list"
  {:spacing "2px"}]

 [".layer-row"
  {:padding "4px 6px"
   :background-color "transparent"
   :border-color "transparent"
   :alignment "center-left"
   :spacing "4px"}
  ["&:hover"
   {:background-color :color-bg-hover}]]

 [".layer-row-selected"
  {:background-color :color-bg-selected}]

 [".layer-visibility-checkbox"
  {:scale-x "0.8"
   :scale-y "0.8"}]

 [".layer-name"
  {:text-fill :color-fg
   :font-size "12px"}]

 [".layer-name-selected"
  {:text-fill :color-accent
   :font-weight "bold"}]

 [".layer-lock-icon"
  {:text-fill :color-fg-muted
   :font-size "10px"}]

 [".layer-button"
  {:font-size "10px"
   :min-width "20px"
   :min-height "20px"
   :padding "2px"
   :background-color "transparent"
   :text-fill :color-fg-muted}
  ["&:hover"
   {:background-color :color-bg-hover}]]

 [".layer-toolbar"
  {:padding "5px 0 0 0"
   :spacing "4px"}]

 [".layer-toolbar-button"
  {:font-size "12px"
   :min-width "24px"
   :min-height "24px"
   :background-color "transparent"
   :text-fill :color-toolbar-fg}
  ["&:hover"
   {:background-color :color-bg-hover}]]]