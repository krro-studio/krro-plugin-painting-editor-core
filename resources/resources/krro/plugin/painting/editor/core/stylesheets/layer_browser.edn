;; component/layer-browser.edn
;; 不带 -text 的，就是容器，只标注可继承样式.
[{}

 [".layer-browser"
  {:background-color :kr/surface
   :padding :p2
   :spacing :p2
   :border-color :kr/border-color
   :border-width "0 0 0 1px"}]

 [".layer-browser-title"
  {:text-fill :kr/secondary-color
   :font-weight :font-weight-bold
   :font-size :font-size-sm
   :padding "0 0 5px 0"}]

 [".layer-list"
  {:spacing "2px"
   :padding :p1
   :background-color :kr/secondary-surface
   :background-radius :radius-lg}]


 ;; 基础 name-box 样式
 [".layer-name-box"
  {:padding "4px 6px"
   :background-color "transparent"
   :border-color "transparent"
   :alignment "center-left"
   :spacing :p1}
  [".layer-name-text"
   {:text-fill :kr/secondary-color}]

  ;; hover 需要强调，背景稍微变化即可
  ["&:hover"
   {:background-color :kr/tertiary-surface}
   [".layer-name-text"
    {:text-fill :kr/emphasis-color}]]]

 ;; 选择时候背景变为主题色
 [".layer-name-box-selected"
  {:background-color :kr/primary-bg-subtle}
  ;; 覆盖，使得hover 时候背景色保持为主题色
  ["&:hover"
   {:background-color :kr/primary-bg-subtle}]]

 [".layer-group-child-list"
  {:padding "0 0 0 12px"}]
 ]